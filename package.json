{
  "name": "unichat",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.cjs",
    "seed:local": "node scripts/seed-local.cjs",
    "dev": "node scripts/dev.cjs",
    "check": "npm --prefix web run build && node --test shared/workspaceAvatar.test.mjs web/src/utils/messageGrouping.test.mjs",
    "test:auth": "npm --prefix backend run test:auth",
    "test:e2e": "playwright test",
    "test:backend": "npm --prefix backend test",
    "lint": "npm --prefix backend run lint",
    "verify": "npm run lint && npm run check && npm run test:backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0"
  }
}
