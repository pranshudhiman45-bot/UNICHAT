# For credential-free testing, run npm run setup:local from the repository root.
# Production: copy this file to backend/.env and supply your own secrets.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/unichat
# Atlas: mongodb+srv://USER:URL_ENCODED_PASSWORD@cluster.xxxxx.mongodb.net/unichat?retryWrites=true&w=majority
# Optional: database name when the URI has none, and the initial connection timeout.
MONGODB_DB_NAME=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000
JWT_SECRET=
JWT_REFRESH_SECRET=
PASSWORD_RESET_PEPPER=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000/api
# Set the exact number of trusted reverse-proxy hops; never enable blindly.
TRUST_PROXY_HOPS=0

# Blank allows any email domain. New workspace memberships always require approval.
# AUTO_JOIN_DEFAULT_WORKSPACE only bootstraps/repairs the legacy owner workspace.
ALLOWED_REGISTRATION_DOMAIN=
AUTO_JOIN_DEFAULT_WORKSPACE=false
WORKSPACE_CREATION=members
REQUIRE_EMAIL_VERIFICATION=true
# email = self-service OTP; admin = existing approval workflow.
PASSWORD_RECOVERY_MODE=email

# Google Identity Services: Web client ID plus accepted Web/iOS client IDs.
# Native Android requests an ID token for the Web client ID.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Gmail/Workspace SMTP: use an app password, never the account password.
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RECOVERY_REVIEW_URL=http://localhost:5173/admin
RECOVERY_APPROVAL_URL=http://localhost:5173/recovery/approve

# Server-only administrator. Run npm run hash:admin-password interactively.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Set COOKIE_SAMESITE=none when the web app is on a different site than the API (e.g. Vercel + Render).
COOKIE_SAMESITE=

FILE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_FILE_SIZE_MB=25
MAX_ATTACHMENTS=10

# Optional for one server; use Redis for shared limits and Socket.IO fan-out.
REDIS_URL=
EXPO_ACCESS_TOKEN=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:notifications@your-domain.example

# ---- Reliability, limits and operations (see docs/PRODUCTION.md) ----
# Grace period (seconds) in which the previous refresh token still works, so a lost refresh response does not log a
# user out. 0 = strict single-use tokens.
REFRESH_REUSE_WINDOW_SECONDS=30
# Presence: how long a user with no connections is still shown online (absorbs reconnects / sleep-wake).
PRESENCE_GRACE_MS=8000
# Redis: wait this long for Redis at startup. In production the API refuses to start without Redis when REDIS_URL is
# set, unless REDIS_OPTIONAL=true (degraded single-instance mode).
REDIS_STARTUP_WAIT_MS=10000
REDIS_OPTIONAL=false
# Rate limits. Signed-in traffic is budgeted per user, anonymous traffic per IP (requests per 15 minutes).
API_RATE_LIMIT_USER=1500
API_RATE_LIMIT_IP=300
MESSAGE_SEND_LIMIT_PER_MINUTE=60
UPLOAD_LIMIT_PER_10_MIN=60
# Uploads are spooled to disk; at most this many are processed at once per instance.
MAX_CONCURRENT_UPLOADS=8
# Socket.IO per-connection event budget (burst / refill per second). Persistent abusers are disconnected.
SOCKET_EVENT_BURST=60
SOCKET_EVENT_RATE=20
# Background cleanup of abandoned uploads, in minutes (0 disables).
CLEANUP_INTERVAL_MINUTES=15
# Notifications older than this are deleted by MongoDB (0 keeps everything).
NOTIFICATION_RETENTION_DAYS=90
# Thread responses return at most this many replies and flag `truncated`.
MAX_THREAD_REPLIES_PER_RESPONSE=1000

